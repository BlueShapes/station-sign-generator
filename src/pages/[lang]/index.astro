---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeadSeo from "../../components/HeadSeo.astro";
import StationSignApp from "../../components/StationSignApp";
import {
  DEFAULT_LOCALE,
  SUPPORTED_LOCALE_CODES,
  getLocalePath,
} from "../../i18n/locales";
import { loadTranslations } from "../../i18n/translations";

export function getStaticPaths() {
  return SUPPORTED_LOCALE_CODES.filter(
    (locale) => locale !== DEFAULT_LOCALE,
  ).map((locale) => ({ params: { lang: locale } }));
}

const { lang } = Astro.params;
const allMessages = Object.fromEntries(
  SUPPORTED_LOCALE_CODES.map((locale) => [locale, loadTranslations(locale)]),
);
const messages = allMessages[lang ?? DEFAULT_LOCALE];

const siteOrigin =
  import.meta.env.SITE ?? "https://stationsigngen.aosankaku.net";
const siteName =
  (messages as Record<string, string>)?.["$site-name"] ??
  "Station Sign Generator";
const title =
  (messages as Record<string, Record<string, string>>)?.meta?.title ??
  "Station Sign Generator";
const description =
  (messages as Record<string, Record<string, string>>)?.meta?.description ?? "";
const ogImagePath =
  (messages as Record<string, string>)?.["$og-image-path"] ??
  "/images/en/ogp.png";
const ogImageAlt =
  (messages as Record<string, Record<string, string>>)?.meta?.["og-image-alt"] ??
  title;
const ogImageUrl = `${siteOrigin}${ogImagePath}`;
const canonical = `${siteOrigin}/${lang}/`;

const alternates = [
  ...SUPPORTED_LOCALE_CODES.map((locale) => ({
    lang: locale,
    href: `${siteOrigin}${getLocalePath(locale)}`,
  })),
  { lang: "x-default", href: `${siteOrigin}/` },
];
---

<BaseLayout title={title} description={description} locale={lang}>
  <Fragment slot="head">
    <HeadSeo
      siteName={siteName}
      title={title}
      description={description}
      locale={lang}
      ogImageUrl={ogImageUrl}
      ogImageAlt={ogImageAlt}
      canonical={canonical}
      alternates={alternates}
    />
  </Fragment>
  <StationSignApp client:only="react" locale={lang} allMessages={allMessages} />
</BaseLayout>
