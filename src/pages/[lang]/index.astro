---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeadSeo from "../../components/HeadSeo.astro";
import StationSignApp from "../../components/StationSignApp";
import {
  DEFAULT_LOCALE,
  SUPPORTED_LOCALE_CODES,
  getLocalePath,
  getManifestPath,
} from "../../i18n/locales";
import { getLocalizedSiteMetadata } from "../../i18n/siteMetadata";
import { loadTranslations } from "../../i18n/translations";

export function getStaticPaths() {
  return SUPPORTED_LOCALE_CODES.filter(
    (locale) => locale !== DEFAULT_LOCALE,
  ).map((locale) => ({ params: { lang: locale } }));
}

const { lang } = Astro.params;
const messages = loadTranslations(lang ?? DEFAULT_LOCALE);
const metadata = getLocalizedSiteMetadata(messages);

const siteOrigin =
  import.meta.env.SITE ?? "https://stationsigngen.aosankaku.net";
const ogImageUrl = `${siteOrigin}${metadata.ogImagePath}`;
const canonical = `${siteOrigin}/${lang}/`;

const alternates = [
  ...SUPPORTED_LOCALE_CODES.map((locale) => ({
    lang: locale,
    href: `${siteOrigin}${getLocalePath(locale)}`,
  })),
  { lang: "x-default", href: `${siteOrigin}/` },
];
---

<BaseLayout title={metadata.title} description={metadata.description} locale={lang}>
  <Fragment slot="head">
    <HeadSeo
      siteName={metadata.siteName}
      title={metadata.title}
      description={metadata.description}
      locale={lang}
      ogImageUrl={ogImageUrl}
      ogImageAlt={metadata.ogImageAlt}
      manifestUrl={getManifestPath(lang ?? DEFAULT_LOCALE)}
      canonical={canonical}
      alternates={alternates}
    />
  </Fragment>
  <StationSignApp client:only="react" locale={lang} />
</BaseLayout>
