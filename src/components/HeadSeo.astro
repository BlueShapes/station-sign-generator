---
import { getOpenGraphLocale } from "../i18n/locales";

interface Alternate {
  lang: string;
  href: string;
}

interface Props {
  siteName: string;
  title: string;
  description: string;
  locale: string;
  ogImageUrl: string;
  ogImageAlt: string;
  manifestUrl: string;
  canonical: string;
  alternates: Alternate[];
}

const { siteName, title, description, locale, ogImageUrl, ogImageAlt, manifestUrl, canonical, alternates } = Astro.props;
const openGraphLocale = getOpenGraphLocale(locale);
const alternateOpenGraphLocales = alternates
  .filter(({ lang }) => lang !== "x-default" && lang !== locale)
  .map(({ lang }) => getOpenGraphLocale(lang));

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "@id": `${canonical}#web-application`,
  name: siteName,
  description,
  url: canonical,
  applicationCategory: "DesignApplication",
  operatingSystem: "Any",
  inLanguage: locale,
  isAccessibleForFree: true,
};

const structuredDataJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href={manifestUrl} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content={openGraphLocale} />
{alternateOpenGraphLocales.map((alternateLocale) => (
  <meta property="og:locale:alternate" content={alternateLocale} />
))}
<meta property="og:site_name" content={siteName} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
{alternates.map(({ lang, href }) => (
  <link rel="alternate" hreflang={lang} href={href} />
))}
<script id="site-structured-data" type="application/ld+json" is:inline set:html={structuredDataJson} />
